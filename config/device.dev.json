{
  "profile": "dev-mac",
  "data_dir": "var/device",
  "listen": "127.0.0.1:8730",
  "log_level": "info",
  "default_language": "hi",
  "memory_limit_mb": 200,
  "shutdown_timeout": "15s",
  "pprof_addr": "",
  "session": {
    "reminder_after": "2m",
    "final_warning_after": "9m",
    "close_after": "10m"
  },
  "api": {
    "turn_timeout": "55s",
    "write_timeout": "70s",
    "sse_max_clients": 4,
    "audio_cache_clips": 8,
    "audio_cache_bytes": 25165824,
    "goodbye_grace": "20s"
  },
  "speech": {
    "stt_engine": "speech-worker",
    "tts_enabled": true,
    "url": "http://127.0.0.1:8743",
    "stt_timeout": "20s",
    "tts_timeout": "30s",
    "max_audio_secs": 20
  },
  "llm": {
    "enabled": true,
    "url": "http://127.0.0.1:8742",
    "timeout": "20s",
    "max_tokens": 256,
    "rephrase": true,
    "classify_timeout": "4s",
    "rephrase_timeout": "8s"
  },
  "dialogue": {
    "min_stt_confidence": 0.45,
    "max_misses": 3
  },
  "knowledge": {
    "path": "packages/scheme-knowledge/records",
    "gazetteer_path": "packages/scheme-knowledge/gazetteer/bihar_districts.json",
    "helplines_path": "packages/scheme-knowledge/helplines.json",
    "require_signed_bundle": false,
    "allow_unverified_for_dev": true
  },
  "sync": {
    "base_url": "",
    "server_keys": {}
  },
  "health": {
    "mem_warn_mb": 150,
    "mem_crit_mb": 220
  },
  "backup": {
    "enabled": false,
    "hour": 3,
    "keep": 7
  },
  "hal": {
    "button": "sim"
  }
}
