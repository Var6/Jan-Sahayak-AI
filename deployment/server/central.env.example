# /etc/jan-sahayak/central.env  (mode 0640, owner root:jansahayak-central)
# Runtime connection: the least-privilege role, never the owner.
JS_DATABASE_URL=postgres://jansahayak_app:CHANGE_ME@127.0.0.1:5432/jansahayak?sslmode=disable
JS_SERVER_KEY=/var/lib/jan-sahayak-central/server.key
JS_ADDR=127.0.0.1:8750
JS_COOKIE_SECURE=true
# Behind deployment/server/Caddyfile on the same host:
JS_TRUST_PROXY=true
# Refuse to start if the role could rewrite the audit log:
JS_STRICT_DB_ROLE=true
# Optional static admin dashboard export (Next.js `output: "export"`, basePath "/admin"):
# JS_ADMIN_UI_DIR=/opt/jan-sahayak-central/admin-ui
