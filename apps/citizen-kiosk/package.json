{
  "name": "citizen-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jan Sahayak citizen kiosk UI (served by the device agent at /).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
